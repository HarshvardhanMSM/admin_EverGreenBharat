# ==============================================================================
# EVER GREEN BHARAT / BHARAT GREEN HUB - ADMIN PANEL ENVIRONMENT CONFIGURATION
# ==============================================================================

# Node Environment (development | production | test)
NODE_ENV=development

# Local Dev Server Port for Admin Panel
PORT=3001

# Backend REST API Endpoint (Must include /api suffix)
# For local dev: http://localhost:3000/api
# For production: https://api.yourdomain.com/api
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Frontend Admin Panel Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Google Maps Platform API Key (Required for live Google Address Autocomplete & Geocoding)
# Enable "Places API" and "Geocoding API" in your Google Cloud Console
# https://console.cloud.google.com/google/maps-apis
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Default Branding & Meta Information
NEXT_PUBLIC_APP_NAME="Bharat Green Hub"
NEXT_PUBLIC_APP_DESCRIPTION="Unified Green Platform & Multi-Vendor Nursery Marketplace Admin Console"

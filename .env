# ==============================================================================
# EVER GREEN BHARAT / BHARAT GREEN HUB - ADMIN PANEL ENVIRONMENT CONFIGURATION
# ==============================================================================
EVER_GREEN_BHARAT
# Node Environment
NODE_ENV=development

# Local Dev Server Port for Admin Panel
PORT=3001

# Backend REST API Endpoint (Port 3000 where backend nestjs server runs)
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Frontend Admin Panel Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Google Maps Platform API Key (Optional for live Google Address Autocomplete & Geocoding)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Default Branding
NEXT_PUBLIC_APP_NAME="Bharat Green Hub"
NEXT_PUBLIC_APP_DESCRIPTION="Unified Green Platform & Multi-Vendor Nursery Marketplace Admin Console"
